# ──────────────────────────────────────────────
#  untis-notifier configuration
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Discord Webhook URL (create one in your Discord server settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# Who to ping when changes are detected.
# Formats:
#   user:123456789012345678   → pings a specific user
#   role:123456789012345678   → pings a role (group ping)
#   (leave empty for no ping)
DISCORD_PING_TARGET=user:YOUR_DISCORD_USER_ID

# ── WebUntis credentials ─────────────────────
# School name (as it appears in your WebUntis URL, e.g., 'my-school' or 'my+school')
UNTIS_SCHOOL_NAME=my school
# Your WebUntis login username
UNTIS_USERNAME=Doe_John
# Your WebUntis login password
UNTIS_PASSWORD=123456
# WebUntis base URL (e.g., borys.webuntis.com — both 'borys.webuntis.com' and 'https://borys.webuntis.com' work)
UNTIS_URL=xxxxx.webuntis.com

# ── Web Server ────────────────────────────────
# Enable the debug web interface (required for iCal sync)
ENABLE_WEB_SERVER=false
# Port for the web interface
WEB_SERVER_PORT=3000
# Disable all routes except iCal (recommended for production)
DISABLE_ROUTES_EXCEPT_ICAL=true

# ── Scanning ──────────────────────────────────
# Interval in milliseconds between checks (default: 600000 = 10 minutes)
CHECK_INTERVAL=600000
# Toggle individual scanners
ENABLE_ABSENCE_SCANNING=true
ENABLE_HOMEWORK_SCANNING=true
ENABLE_EXAM_SCANNING=true
ENABLE_TIMETABLE_SCANNING=true

# ── Misc ──────────────────────────────────────
# Start of the date range for fetching data (recommended: start of school year)
RANGE_START=2024-09-09T00:00:00
# Enable iCal streaming (sync timetable to calendar apps) — requires web server
ENABLE_ICAL_STREAMING=false
# Custom name for the generated iCal file to prevent bot scraping (e.g., 'secret-calendar.ics')
ICAL_FILE_NAME=
# Timezone to use for iCal events (default: Europe/Berlin)
ICAL_TIMEZONE=Europe/Berlin
# Enable debug mode (verbose console output)
ENABLE_DEBUG=false
# Enable CORS for the iCal route (useful for https://larrybolt.github.io/online-ics-feed-viewer/)
ENABLE_CORS_FOR_ICS_VIEWER=false
